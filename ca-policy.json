{
  "policy": {
    "key_props": {
      "exportable": false,
      "kty": "RSA",
      "key_size": 4096,
      "reuse_key": false
    },
    "secret_props": {
      "contentType": "application/x-pem-file"
    },
    "x509_props": {
      "subject": "CN=MyOrg Root CA",
      "key_usage": [
        "keyCertSign",
        "cRLSign"
      ],
      "basic_constraints": {
        "ca": true
      },
      "validity_months": 120
    },
    "issuer": {
      "name": "Self"
    }
  }
}